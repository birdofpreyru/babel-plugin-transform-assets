{
  "name": "@dr.pogodin/babel-plugin-transform-assets",
  "version": "2.0.0",
  "description": "Transforms importing of asset files at compile time using Babel",
  "main": "build/index.js",
  "author": "Dr. Sergey Pogodin <doc@pogodin.studio> (https://dr.pogodin.studio)",
  "license": "MIT",
  "homepage": "https://dr.pogodin.studio/docs/babel-plugin-transform-assets",
  "keywords": [
    "babel",
    "webpack",
    "file-loader",
    "babel-plugin",
    "asset",
    "require",
    "import",
    "hook",
    "plugin",
    "universal",
    "isomorphic",
    "asset-require-hook"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "npm run clean && node node_modules/.bin/babel src --out-dir build -x .ts",
    "lint": "eslint --cache",
    "mocha": "node node_modules/.bin/mocha --require @babel/register 'test/**/*.spec.mjs'",
    "test": "npm run lint && npm run typecheck && npm run mocha",
    "typecheck": "tsc --noEmit"
  },
  "repository": "github:birdofpreyru/babel-plugin-transform-assets",
  "bugs": {
    "url": "https://github.com/birdofpreyru/babel-plugin-transform-assets/issues"
  },
  "dependencies": {
    "enhanced-resolve": "^5.24.1",
    "loader-utils": "^3.3.1"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.1",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@dr.pogodin/eslint-configs": "^0.3.0-alpha.3",
    "@tsconfig/recommended": "^1.0.13",
    "@types/loader-utils": "^3.0.0",
    "@types/node": "^24.13.2",
    "chai": "^6.2.2",
    "fs-monkey": "^1.1.0",
    "gulp-babel": "^8.1.0",
    "memfs": "^4.57.8",
    "mocha": "^11.7.6",
    "mocha-each": "^2.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "unionfs": "4.5.4",
    "vinyl": "^3.0.1",
    "webpack": "^5.108.1"
  }
}
