{
  "name": "@dr.pogodin/babel-plugin-transform-assets",
  "version": "1.2.6",
  "description": "Transforms importing of asset files at compile time using Babel",
  "main": "build/index.js",
  "author": "Dr. Sergey Pogodin <doc@pogodin.studio> (https://dr.pogodin.studio)",
  "license": "MIT",
  "homepage": "https://dr.pogodin.studio/docs/babel-plugin-transform-assets",
  "keywords": [
    "babel",
    "webpack",
    "file-loader",
    "babel-plugin",
    "asset",
    "require",
    "import",
    "hook",
    "plugin",
    "universal",
    "isomorphic",
    "asset-require-hook"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "npm run clean && node node_modules/.bin/babel src --out-dir build",
    "lint": "eslint --cache",
    "mocha": "node node_modules/.bin/mocha --require @babel/register 'test/**/*.spec.mjs'",
    "test": "npm run lint && npm run mocha"
  },
  "repository": "github:birdofpreyru/babel-plugin-transform-assets",
  "bugs": {
    "url": "https://github.com/birdofpreyru/babel-plugin-transform-assets/issues"
  },
  "dependencies": {
    "enhanced-resolve": "^5.19.0",
    "loader-utils": "^3.3.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/register": "^7.28.6",
    "@dr.pogodin/eslint-configs": "^0.2.7",
    "chai": "^6.2.2",
    "fs-monkey": "^1.1.0",
    "gulp-babel": "^8.0.0-beta.2",
    "memfs": "^4.56.10",
    "mocha": "^11.7.5",
    "mocha-each": "^2.0.1",
    "rimraf": "^6.1.3",
    "unionfs": "4.5.4",
    "vinyl": "^3.0.1"
  }
}
